{
	"plugins": ["typescript", "unicorn", "oxc"],
	"jsPlugins": ["eslint-plugin-oxfmt"],
	"categories": {
		"correctness": "error"
	},
	"rules": {
		"oxfmt/oxfmt": "error"
	},
	"overrides": [
		{
			"files": ["*.test.ts"],
			"rules": {
				"no-sparse-arrays": "allow",
				"unicorn/no-new-array": "allow"
			}
		}
	],
	"env": {
		"builtin": true
	}
}
