{
	"name": "isguard-ts",
	"version": "3.1.4",
	"description": "a typescript library for building type guards quickly while maintaining type safety",
	"main": "dist/index.js",
	"scripts": {
		"test": "vitest --run",
		"build": "vite build",
		"lint": "oxlint",
		"format": "oxfmt",
		"docs": "typedoc",
		"prepublishOnly": "npm run test && npm run build",
		"postpublish": "bash ./scripts/post-publish.sh"
	},
	"keywords": [
		"assert",
		"builder",
		"check",
		"guard",
		"is",
		"is array",
		"is enum",
		"is instanceof",
		"is intersection",
		"is lazy",
		"is literal",
		"is map",
		"is union",
		"is record",
		"is refine",
		"is set",
		"is tuple",
		"is type",
		"is object",
		"is typeof",
		"is optional",
		"is maybe",
		"is value",
		"ts",
		"typescript",
		"typeguards",
		"types",
		"validate"
	],
	"homepage": "https://github.com/razhayat/isguard-ts#readme",
	"bugs": {
		"url": "https://github.com/razhayat/isguard-ts/issues"
	},
	"author": {
		"name": "Raz Hayat"
	},
	"license": "ISC",
	"files": [
		"dist/*"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/razhayat/isguard-ts"
	},
	"peerDependencies": {
		"zod": ">= 3.20.0 < 5.0.0"
	},
	"peerDependenciesMeta": {
		"zod": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^24.12.4",
		"@vitest/coverage-v8": "^4.0.18",
		"eslint-plugin-oxfmt": "^0.8.0",
		"oxfmt": "^0.51.0",
		"oxlint": "^1.66.0",
		"typedoc": "^0.28.19",
		"typescript": "^6.0.3",
		"vite": "^5.4.21",
		"vite-plugin-dts": "^4.5.4",
		"vitest": "^4.0.18",
		"zod": "^4.1.12"
	}
}
